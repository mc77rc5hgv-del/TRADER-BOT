ENV=dev

# Telegram
TELEGRAM_BOT_TOKEN=

# Database
DATABASE_URL=postgresql+asyncpg://trade_ai:trade_ai@localhost:5432/trade_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM provider (interface is provider-agnostic; see app/ai/provider.py).
# ANTHROPIC_API_KEY is read directly by the Anthropic SDK - set that instead
# of LLM_API_KEY unless you're routing through a different provider.
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# API
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Mini App (leave empty until the Mini App frontend is deployed - Phase 1 step 7)
MINI_APP_URL=

# Screenshot storage (local filesystem fallback for dev; swap for S3 in prod)
SCREENSHOT_STORAGE_DIR=./data/screenshots
SCREENSHOT_RETENTION_DAYS=30
SCREENSHOT_MAX_BYTES=8388608
